{
  "expo": {
    "name": "Compagnon de voyage",
    "slug": "compagnon-de-voyage",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17120E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.compagnondevoyage.app"
    },
    "android": {
      "package": "com.compagnondevoyage.app",
      "adaptiveIcon": {
        "backgroundColor": "#17120E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17120E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F4B740"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Autoriser Compagnon de voyage à utiliser le microphone pour dicter votre programme.",
          "speechRecognitionPermission": "Autoriser Compagnon de voyage à utiliser la reconnaissance vocale."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Compagnon de voyage à accéder à vos photos pour ajouter des documents.",
          "cameraPermission": "Autoriser Compagnon de voyage à utiliser l'appareil photo pour ajouter des documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Compagnon de voyage à utiliser l'appareil photo pour scanner vos billets et codes-barres."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser Compagnon de voyage à utiliser votre position pour vous rappeler le code de réservation quand vous approchez de votre hôtel.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-background-task"
    ]
  }
}
