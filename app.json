{
  "expo": {
    "name": "Compagnon de voyage",
    "slug": "companiontrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#170F1F",

    "extra": {
      "eas": {
        "projectId": "fa1318e3-8d73-4853-abee-f913dafc9fc1"
      }
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.compagnondevoyage.app"
    },

    "android": {
      "package": "com.compagnondevoyage.app",
      "adaptiveIcon": {
        "backgroundColor": "#170F1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#F4B740"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Autoriser Compagnon de voyage à utiliser le microphone pour dicter votre programme.",
          "speechRecognitionPermission": "Autoriser Compagnon de voyage à utiliser la reconnaissance vocale."
        }
      ]
    ]
  }
}
